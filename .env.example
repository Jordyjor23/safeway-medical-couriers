# Copy to .env.local. Never commit real secrets.

# PostgreSQL
DATABASE_URL="postgresql://safeway:safeway@localhost:5432/safeway"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# One-time owner bootstrap at /setup. Generate a long random string.
OWNER_SETUP_SECRET=""

# 32-byte key, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# Vercel Blob (private document storage)
BLOB_READ_WRITE_TOKEN=""

# Transactional email
RESEND_API_KEY=""
EMAIL_FROM="Safeway Couriers <noreply@safewaycouriers.com>"

# Optional cron authentication for expiration alerts
CRON_SECRET=""
