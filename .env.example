# Copy to `.env.local` for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# Local development (http://localhost:3000)
# ---------------------------------------------------------------------------

# PostgreSQL — local Docker or a hosted dev database. Not for production.
DATABASE_URL="postgresql://safeway:safeway@localhost:5432/safeway"
# Optional. Direct (non-pooled) URL used only by prisma migrate deploy.
# On Vercel/Neon, set this to the non-pooling connection string.
DIRECT_URL="postgresql://safeway:safeway@localhost:5432/safeway"

# Public origin of this app in the current environment.
# Local: http://localhost:3000
# Production (Vercel): https://portal.safewaycouriers.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Deprecated alias kept so existing local files still work.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Must match the URL users actually sign in on.
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Defaults to portal.safewaycouriers.com in production redirects.
PORTAL_HOST="portal.safewaycouriers.com"

# Optional comma-separated extra CORS / auth origins (preview URLs, etc.)
AUTH_TRUSTED_ORIGINS=""

# One-time owner bootstrap at /setup. Generate a long random string.
OWNER_SETUP_SECRET=""

# 32-byte key, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# Vercel Blob (private document storage)
BLOB_READ_WRITE_TOKEN=""

# Optional document upload limits (server-side only; never expose to the browser)
# DOCUMENT_MAX_BYTES=20971520
# DOCUMENT_SIGNED_URL_SECONDS=60
# Leave empty in production until extraction is explicitly approved.
# DOCUMENT_EXTRACTION_PROVIDER=""
# DOCUMENT_EXTRACTION_PROVIDER=azure
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
# AZURE_DOCUMENT_INTELLIGENCE_KEY=""
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION="2024-11-30"
# DOCUMENT_EXTRACTION_PROVIDER=test is local-only and ignored in production.
# Document expiration/compliance emails stay off unless this is exactly true.
# DOCUMENT_EMAIL_NOTIFICATIONS="false"
# In-app Notification rows are still created when email is disabled.
# SMS is not enabled. Do not add an SMS vendor here.

# Transactional email — required to actually send activation messages.
# Local employee creation will not appear in Resend until this is set.
RESEND_API_KEY=""
EMAIL_FROM="Safeway Couriers <noreply@safewaycouriers.com>"

# Optional cron authentication for expiration alerts
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Vercel production — set these in the Vercel project (do not commit values)
# ---------------------------------------------------------------------------
#
# DATABASE_URL                 Hosted Postgres (Neon, Vercel Postgres, etc.)
#                              Use the pooled URL for the app. Must be available at build time.
# DIRECT_URL                   Optional non-pooling URL for prisma migrate deploy
# BETTER_AUTH_SECRET           openssl rand -base64 32
# BETTER_AUTH_URL              https://portal.safewaycouriers.com
# NEXT_PUBLIC_APP_URL          https://portal.safewaycouriers.com
# NEXT_PUBLIC_SITE_URL         https://portal.safewaycouriers.com
# PORTAL_HOST                  portal.safewaycouriers.com
# OWNER_SETUP_SECRET           long random string (only needed if no Owner exists)
# DATA_ENCRYPTION_KEY          openssl rand -base64 32
# BLOB_READ_WRITE_TOKEN        from Vercel Blob
# RESEND_API_KEY               from Resend
# EMAIL_FROM                   Safeway Couriers <noreply@safewaycouriers.com>
# CRON_SECRET                  long random string
# AUTH_TRUSTED_ORIGINS         optional extra origins
#
# Marketing site remains https://www.safewaycouriers.com (same Vercel project).
# Do not point production DATABASE_URL at localhost.
